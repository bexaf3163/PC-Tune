<?xml version="1.0" encoding="utf-8"?>
<!--
  Этот файл нужен ради одной строки — EnableWindowsFormsHighDpiAutoResizing.
  Без неё WinForms не пересоздаёт шрифты при переезде окна на экран с другим
  масштабом: коробки вёрстки вырастают, а буквы остаются прежними.

  Сам режим осведомлённости о DPI объявляется из кода (Ui.DeclareDpiAware),
  а не здесь, чтобы его можно было откатить настройкой DpiMode в реестре.
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
